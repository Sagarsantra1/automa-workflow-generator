    {
      "id": "vdby1vt",
      "type": "javascript-code",
      "description": "Format text",
      "data": {
        "code": "// Select all paragraphs in div.txt\nconst nodes = Array.from(document.querySelectorAll(\"div.txt p\"));\n\n// Filter out translator/editor lines, empties, and the specified novel promotion line\nconst filteredList = nodes\n  .map(p => p.innerText.trim())\n  .filter(t => \n    t && \n    !t.startsWith(\"Translator:\") && \n    !t.startsWith(\"Editor:\") && \n    t !== \"Visit and read more novel to help us update chapter quickly. Thank you so much!\"\n  );\n\n// FORMAT THE DATA: Join the array into a single string with double newlines\n// Use '\\n' for single spacing or '\\n\\n' for paragraph spacing\nconst formattedText = filteredList.join('\\n\\n');\n\n// Save the cleaned, formatted string to the variable\nautomaSetVariable('filteredText', formattedText);",
        "context": "website",
        "description": "Format text",
        "disableBlock": false,
        "everyNewTab": false,
        "preloadScripts": [],
        "runBeforeLoad": false,
        "timeout": 20000
      },
